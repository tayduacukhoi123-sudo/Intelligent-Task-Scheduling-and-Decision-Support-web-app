# ============================================================
# .env.example — Environment Variables for Task Priority Manager
# ============================================================
# Copy this file to .flaskenv and fill in your own values:
#   cp .env.example .flaskenv
# ============================================================

# --- Flask ---
FLASK_APP=app:create_app
FLASK_DEBUG=1

# --- Database ---
# SQLite (local development):
DATABASE_URL=sqlite:///database.db
# PostgreSQL (production / Neon / Render):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- App Secret ---
SECRET_KEY=your-secret-key-here

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Google Gemini API (AI task parsing) ---
GEMINI_API_KEY=your-gemini-api-key

# --- SMTP / Email Notifications ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
